# engine_toy is versioned as a directory of the root coordination repo
# (root .gitignore whitelists it with `!/engine_toy/`).  Every rule about
# what inside it is NOT source lives here, so the directory carries its own
# ignore set and can become its own repository unchanged.

# Local build byproducts and caches -- regenerated by running the sim,
# not source.
__pycache__/
*.pyc
.pytest_cache/
build/
repo-cache/
__llvm_lawcache__/
artifacts/llvm_pieces/
_tmp_test_mesh.obj
time_trials/generated_ssa_helpers.py
time_trials/ssa_helper_metadata.json

# Renders and logs.  Every trial and reference script writes a PNG or an
# animated PNG beside itself, and the live windows write run logs.  They
# are outputs of the scripts that are tracked, reproducible by running
# them (73 of them landed in one commit, 8387de4, before this rule).
*.png
*.log
time_trials/frames/

# Baked native artifacts.  `structure_native` and `interior_ballistics`
# build into baked/<law>_<digest>/ and the digest IS the identity: same
# generated source, same machine code.  Tracking the DLL, LIB, LL, PDB and
# pickles puts megabytes of build output in history to say something the
# source already says, and a stale one is worse than none because the
# cache is keyed to rebuild only when the digest changes.
baked/

# Editor backups.
*.bak
*.bak2
